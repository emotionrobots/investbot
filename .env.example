# Copy to .env and fill in. `.env` is auto-loaded by python-dotenv.

# --- LLM ---
# Leave ANTHROPIC_API_KEY unset (or set INVESTBOT_MOCK=1) to run the whole
# simulation with deterministic heuristic "agents" — no API calls, no cost.
ANTHROPIC_API_KEY=

# Force heuristic agents even if a key is present (great for long back-runs):
INVESTBOT_MOCK=0

# Agent model. Opus 4.8 is the most capable; claude-sonnet-5 is cheaper for
# the many calls a continuous loop makes.
INVESTBOT_MODEL=claude-opus-4-8

# --- Portfolio ---
INVESTBOT_CAPITAL=100000          # fake starting capital (USD)
INVESTBOT_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,AVGO,TSLA,AMD,CRM
INVESTBOT_BENCHMARK=QQQ            # "real portfolio" comparison ticker
INVESTBOT_INTERVAL_MIN=60         # minutes between trading cycles (continuous mode)

# --- Storage ---
INVESTBOT_DB=investbot.db
INVESTBOT_REPORTS=reports
